# Copy to .env (or set in your shell). Defaults shown.
SENTRIX_DEMO_PASSWORD=sentrix-demo
SENTRIX_DATA_DIR=./data
SENTRIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTRIX_TOKEN_TTL_SECONDS=600
SENTRIX_EMBEDDINGS=1
